# Admin password for the web app. 12 characters or more. Required outside the demo.
# Without it the admin pages and API stay closed and /login shows a setup page.
LOOKALIKE_ADMIN_PASSWORD=
# Alternative to the plain password: the output of `npm run hash-password -- 'your password'`. Wins if both are set.
# LOOKALIKE_ADMIN_PASSWORD_HASH=
# Optional. Key that signs session cookies. Default: derived from the password, so a new password signs everyone out.
# LOOKALIKE_SESSION_SECRET=
# Optional. Set to 0 only to test over plain http in production mode. Leave unset otherwise.
# LOOKALIKE_COOKIE_SECURE=

# Token for real runs. Create it in looot Settings, Agent tokens. The CLI reads the shell, not this file.
LOOOT_TOKEN=
# looot API base URL used to read live prices. Default https://api.looot.ai
# LOOOT_API_URL=
# Most one web UI action (enrich seeds, search) may spend, in dollars. Default 1. The CLI uses --cap.
LOOKALIKE_CAP_USD=1
# Optional weights file for the web app. Default weights.yaml, else weights.example.yaml
LOOKALIKE_WEIGHTS=
# Optional session file for the web app. Default data/session.json
LOOKALIKE_SESSION=
