# Needed for real runs. Create an agent token at https://looot.ai/settings
LOOOT_TOKEN=
# Most one action (enrich seeds, search) may spend in the web UI, in dollars. Default 1
LOOKALIKE_CAP_USD=1
# Optional paths. Defaults: weights.yaml (else weights.example.yaml) and data/session.json
LOOKALIKE_WEIGHTS=
LOOKALIKE_SESSION=
